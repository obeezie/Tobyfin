<?xml version="1.0" encoding="utf-8"?>
<!-- Tobyfin: switch knob, white when on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="22dp" android:height="22dp">
                <shape android:shape="oval"><solid android:color="@android:color/transparent" /></shape>
            </item>
            <item android:width="16dp" android:height="16dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="#FFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="22dp" android:height="22dp">
                <shape android:shape="oval"><solid android:color="@android:color/transparent" /></shape>
            </item>
            <item android:width="16dp" android:height="16dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@color/tobyfin_knob_off" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
