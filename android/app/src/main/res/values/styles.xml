<resources>
    <!-- Application theme -->
    <style name="AppTheme.V21" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/jellyfin_primary</item>
        <item name="colorPrimaryDark">@color/jellyfin_primary_dark</item>
        <item name="colorAccent">@color/jellyfin_accent</item>
        <item name="android:windowBackground">@color/theme_background</item>
        <item name="android:navigationBarColor">@color/theme_background</item>
    </style>

    <style name="AppTheme" parent="AppTheme.V21" />

    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/theme_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/tobyfin_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Settings theme: Tobyfin navy, switches with the gradient track, rounded dialogs -->
    <style name="AppTheme.Settings">
        <item name="android:textColorPrimary">@color/tobyfin_text</item>
        <item name="android:textColorSecondary">@color/tobyfin_muted</item>
        <item name="colorControlActivated">@color/tobyfin_cyan</item>
        <item name="colorControlNormal">@color/tobyfin_faint</item>
        <item name="switchStyle">@style/Tobyfin.Switch</item>
        <item name="alertDialogTheme">@style/Tobyfin.Dialog</item>
    </style>

    <style name="Tobyfin.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/tobyfin_switch_track</item>
        <item name="android:thumb">@drawable/tobyfin_switch_thumb</item>
        <item name="trackTint">@null</item>
        <item name="thumbTint">@null</item>
        <item name="switchMinWidth">38dp</item>
    </style>

    <style name="Tobyfin.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/tobyfin_dialog_background</item>
        <item name="colorAccent">@color/tobyfin_cyan</item>
        <item name="colorControlActivated">@color/tobyfin_cyan</item>
        <item name="android:textColorPrimary">@color/tobyfin_text</item>
        <item name="android:textColorSecondary">@color/tobyfin_muted</item>
    </style>

    <!-- Theme Overlays -->
    <style name="ThemeOverlay.App.BackButton" parent="">
        <item name="colorControlNormal">?android:textColorPrimary</item>
    </style>
</resources>
