<?xml version="1.0" encoding="utf-8"?>
<!-- Android's 288dp splash canvas has a 192dp circular safe area. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="144dp" android:height="144dp" android:gravity="center">
        <bitmap
            android:src="@drawable/tobyfin_icon"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>